<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BwSshAgent.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:BwSshAgent.App">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,32" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
            <Grid>
                <TextBlock Text="{l:T Zh='诊断', En='Diagnostics'}" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Click="OnRecheck">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="{l:T Zh='重新检查', En='Check again'}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:T Zh='SSH agent 管道', En='SSH agent pipe'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="PipeStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:T Zh='可能冲突的程序', En='Possible conflicts'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="ConflictStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel x:Name="ServiceFix" Spacing="6" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Text="{l:T Zh='Windows 自带的 OpenSSH Authentication Agent 服务会占用同一个管道。以管理员身份在 PowerShell 中运行以下命令即可停用它：', En='The built-in Windows OpenSSH Authentication Agent service uses the same pipe. Run this in an elevated PowerShell to disable it:'}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServiceCommand" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="{l:T Zh='复制', En='Copy'}" Click="OnCopyServiceCommand" VerticalAlignment="Top" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:T Zh='Git 使用的 SSH 客户端', En='SSH client used by Git'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="GitStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel x:Name="GitFix" Spacing="6" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Text="{l:T Zh='Git for Windows 自带的 ssh 不认识 Windows 命名管道。让 Git 改用系统自带的 OpenSSH（Claude Code 等 Agent 调用 git 时同样生效）：', En='The ssh bundled with Git for Windows cannot use Windows named pipes. Make Git use the built-in Windows OpenSSH instead (this also applies when agents such as Claude Code run git):'}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GitCommand" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="{l:T Zh='复制', En='Copy'}" Click="OnCopyGitCommand" VerticalAlignment="Top" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:T Zh='连接测试', En='Connection test'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{l:T Zh='用系统 OpenSSH 的 ssh-add -L 列出 agent 中的公钥（不会触发签名，也不需要批准）。', En='Lists the public keys in the agent with the Windows OpenSSH ssh-add -L (no signing, no approval needed).'}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:T Zh='运行 ssh-add -L', En='Run ssh-add -L'}" Click="OnTest" />
                        <Button Content="{l:T Zh='打开程序日志', En='Open app log'}" Click="OnOpenLog" />
                    </StackPanel>
                    <TextBox x:Name="TestOutput" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="80"
                             Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
