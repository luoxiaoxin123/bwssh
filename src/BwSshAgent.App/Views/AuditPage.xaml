<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BwSshAgent.App.Views.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:BwSshAgent.App"
    xmlns:local="using:BwSshAgent.App.Views">
    <Grid Margin="32,24,32,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{l:T Zh='审计日志', En='Audit log'}" Style="{StaticResource TitleTextBlockStyle}" />
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" PlaceholderText="{l:T Zh='筛选：程序、密钥、目标主机、结果…', En='Filter: program, key, host, result…'}" TextChanged="OnFilterChanged" />
            <ComboBox x:Name="RangeBox" Grid.Column="1" SelectionChanged="OnRangeChanged" MinWidth="110">
                <ComboBoxItem Content="{l:T Zh='今天', En='Today'}" Tag="1" />
                <ComboBoxItem Content="{l:T Zh='最近 7 天', En='Last 7 days'}" Tag="7" />
                <ComboBoxItem Content="{l:T Zh='最近 30 天', En='Last 30 days'}" Tag="30" />
            </ComboBox>
            <Button Grid.Column="2" Click="OnRefresh" ToolTipService.ToolTip="{l:T Zh='刷新', En='Refresh'}">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button Grid.Column="3" Click="OnOpenFolder" ToolTipService.ToolTip="{l:T Zh='打开日志文件夹', En='Open log folder'}">
                <FontIcon Glyph="&#xE838;" FontSize="14" />
            </Button>
        </Grid>
        <ListView x:Name="EntriesList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:AuditRow">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock>
                                <Run Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="  " />
                                <Run Text="{x:Bind Decision}" FontWeight="SemiBold" />
                                <Run Text="  " />
                                <Run Text="{x:Bind Operation}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind Process}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="{l:T Zh='没有记录', En='No entries'}" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
