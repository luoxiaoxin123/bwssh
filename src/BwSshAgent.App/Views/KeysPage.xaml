<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BwSshAgent.App.Views.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:BwSshAgent.App"
    xmlns:local="using:BwSshAgent.App.Views">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,32" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="{l:T Zh='SSH 密钥', En='SSH keys'}" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar x:Name="ReauthBar" Severity="Warning" IsOpen="False" IsClosable="False" Title="{l:T Zh='需要重新登录', En='Sign-in required'}">
                <InfoBar.ActionButton>
                    <Button Content="{l:T Zh='重新登录', En='Sign in again'}" Click="OnRelogin" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="PipeBar" Severity="Error" IsOpen="False" IsClosable="False" Title="{l:T Zh='SSH agent 管道被占用', En='SSH agent pipe is in use'}" />
            <InfoBar x:Name="SyncErrorBar" Severity="Warning" IsOpen="False" IsClosable="True" Title="{l:T Zh='同步失败', En='Sync failed'}" />
            <InfoBar x:Name="DecryptBar" Severity="Warning" IsOpen="False" IsClosable="True" Title="{l:T Zh='部分条目无法加载', En='Some items could not be loaded'}" />
            <InfoBar x:Name="ActionBar" IsOpen="False" IsClosable="True" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="AccountText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="PipeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="SyncText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ModeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="SyncButton" Click="OnSync">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="{l:T Zh='同步', En='Sync'}" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnLock">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock Text="{l:T Zh='锁定', En='Lock'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="GrantsPanel" Spacing="8" Visibility="Collapsed">
                <Grid>
                    <TextBlock Text="{l:T Zh='临时授权中的程序', En='Programs currently allowed'}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="{l:T Zh='全部撤销', En='Revoke all'}" HorizontalAlignment="Right" Click="OnRevoke" />
                </Grid>
                <ItemsControl x:Name="GrantsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid>
                <TextBlock x:Name="KeysHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="AddButton" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="OnAdd">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="{l:T Zh='添加密钥', En='Add key'}" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{l:T Zh='密码库里还没有 SSH 密钥。点右上角“添加密钥”生成或导入一把。', En='No SSH keys in your vault yet. Use Add key to generate or import one.'}" />
            <ItemsControl x:Name="KeysList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:KeyRow">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE192;" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="{l:T Zh='复制公钥', En='Copy public key'}" Tag="{x:Bind PublicKeyLine}" Click="OnCopy" />
                                    <Button Tag="{x:Bind CipherId}" ToolTipService.ToolTip="{l:T Zh='更多', En='More'}">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{l:T Zh='改名…', En='Rename…'}" Tag="{x:Bind CipherId}" Click="OnRename">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8AC;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{l:T Zh='移到回收站…', En='Move to trash…'}" Tag="{x:Bind CipherId}" Click="OnDelete">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
